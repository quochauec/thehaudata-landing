# Hostinger serves .mjs as text/plain; module scripts need a JavaScript MIME type.
AddType application/javascript .mjs
AddType application/wasm .wasm

# Not public: keep search engines out.
Header set X-Robots-Tag "noindex, nofollow"

# Without a charset, browsers guess Latin-1 and garble arrows, dots and dashes.
AddDefaultCharset UTF-8

# Mentee login (PHP). Every request goes through _gate.php, which checks the session and then serves the file.
# /login, /admin and /logout are the three pages; everything else needs a signed-in mentee.
# Accounts live outside public_html (../../lab-data), so a git deploy never touches them.
Options -Indexes
RewriteEngine On
RewriteRule ^(login|admin|logout|answer|progress)/?$ $1.php [L]
RewriteRule ^(login|admin|logout|answer|progress|_gate)\.php$ - [L]
# The runtime libraries (DuckDB, Pyodide, sqlglot, editor bundle) hold no mentee data and no answers. Apache serves them straight,
# without PHP, so a class signing in together does not use up the host's PHP processes. Pages, data and answers stay behind the gate.
RewriteRule ^vendor/ - [E=LABVENDOR:1,L]
RewriteRule ^ _gate.php [L]

# Cache the libraries for a week (they change only when the vendor files are rebuilt) and compress what compresses well.
<IfModule mod_headers.c>
Header set Cache-Control "public, max-age=604800" env=LABVENDOR
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE application/wasm application/javascript text/javascript application/json
</IfModule>
